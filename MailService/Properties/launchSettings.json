{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Development (https)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7232;http://localhost:5107",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Development (http)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
